#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\Users\highj\Documents\Projects\EvoTime\tests\host -BC:\Users\highj\Documents\Projects\EvoTime\build\host-tests
  description = Re-running CMake...
  generator = 1


