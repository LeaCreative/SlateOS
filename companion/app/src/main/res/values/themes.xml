<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Slate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialButtonStyle">@style/Widget.Slate.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Slate.Button.Text</item>
    </style>

    <style name="Widget.Slate.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Slate.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
