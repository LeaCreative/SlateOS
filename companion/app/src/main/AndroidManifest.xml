<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <!-- Required for AssociationRequest.DEVICE_PROFILE_WATCH (API 31+); missing → SecurityException on associate(). -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_PROFILE_WATCH" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phone vibration for the "vibrate" sub-app permission. Normal-level:
         granted at install, no runtime request. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The phone's position, for the "location" sub-app permission. Dangerous
         level: both need a runtime grant, and the user can give COARSE while
         refusing FINE, so LocationAdapter treats either as sufficient and does
         not assume the accuracy it got. Deliberately NOT
         ACCESS_BACKGROUND_LOCATION: a sub-app only draws while the watch is
         showing its screen, so there is no case for tracking with the app in
         the background, and that permission needs a separate settings trip. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Lets the link service claim the "location" FGS type, which is what
         keeps fixes arriving while the app is backgrounded — the normal state
         for a watch companion. Normal-level, so declaring it costs nothing;
         the service still claims the type only when the runtime grant is held
         (LinkForegroundService.foregroundTypes). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.plus" />
        <intent>
            <action android:name="net.osmand.aidl.OsmandAidlServiceV2" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <!-- Required for CompanionDeviceManager.associate(); missing → IllegalStateException. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SlateApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_rules"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="Slate"
        android:supportsRtl="true"
        android:theme="@style/Theme.Slate">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect permission rationale (Android ≤13 / standalone HC).
             Without this + the ViewPermissionUsageActivity alias below, Grant
             on Android 14+ returns empty with no UI. -->
        <activity
            android:name=".health.HealthConnectRationaleActivity"
            android:exported="true"
            android:label="Health Connect">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.HealthConnectRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:label="Permissions" />

        <activity
            android:name=".DebugActivity"
            android:exported="false"
            android:label="Debug" />

        <activity
            android:name=".ota.SealedDfuProbeActivity"
            android:exported="false"
            android:label="Install firmware (sealed)" />

        <activity
            android:name=".ota.SlateOtaActivity"
            android:exported="false"
            android:label="Update Slate firmware" />

        <activity
            android:name=".bench.BenchmarkActivity"
            android:exported="false"
            android:label="Slate benchmarks" />

        <activity
            android:name=".script.DevConsoleActivity"
            android:exported="false"
            android:label="Script console" />

        <activity
            android:name=".repo.RepoActivity"
            android:exported="false"
            android:label="Sub-app repository" />

        <activity
            android:name=".health.HeartRateActivity"
            android:exported="false"
            android:label="Heart rate" />

        <activity
            android:name=".settings.WatchSettingsActivity"
            android:exported="false"
            android:label="Watch settings" />

        <activity
            android:name=".settings.PhoneBridgesActivity"
            android:exported="false"
            android:label="Phone bridges" />

        <receiver
            android:name=".alarms.ExactAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="slate.app.action.EXACT_ALARM" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".link.TroubleshootingActivity"
            android:exported="false"
            android:label="Troubleshooting" />

        <activity
            android:name=".link.LogActivity"
            android:exported="false"
            android:label="Log" />

        <!-- Open a .zip as either a JS sub-app (sideload) or slate-dfu.zip
             (SDP OTA). Classification is in ZipIntake / SideloadActivity. -->
        <activity
            android:name=".repo.SideloadActivity"
            android:exported="true"
            android:label="Open with Slate">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <!-- "location" is permitted here but claimed at runtime only when the
             user has granted it; see LinkForegroundService.foregroundTypes.
             Declaring a type does not oblige the service to use it. -->
        <service
            android:name=".link.LinkForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <service
            android:name=".ota.SealedDfuService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".ota.SlateOtaService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".notif.SlateNotificationListener"
            android:exported="true"
            android:label="Slate notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".link.SlateCompanionDeviceService"
            android:enabled="@bool/companion_presence_service_enabled"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="31">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".link.CompanionStartupReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
