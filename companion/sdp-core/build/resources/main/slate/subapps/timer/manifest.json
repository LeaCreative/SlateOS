{
  "id": "slate.timer",
  "name": "Timer",
  "version": "1.1.0",
  "entry": "main.js",
  "minProtocolVersion": 1,
  "minHostVersion": "0.1",
  "priority": "normal",
  "refreshPolicy": "on-change",
  "permissions": [
    "storage"
  ],
  "allowedHosts": [],
  "settings": [
    {
      "key": "durationSec",
      "label": "Countdown duration",
      "type": "int",
      "default": 60,
      "min": 5,
      "max": 3600,
      "unit": "s",
      "help": "How long the timer starts from. Applies next time you open it."
    }
  ]
}
