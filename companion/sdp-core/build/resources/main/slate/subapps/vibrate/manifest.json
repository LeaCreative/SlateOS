{
  "id": "slate.vibrate",
  "name": "Buzz Phone",
  "version": "1.1.0",
  "entry": "main.js",
  "minProtocolVersion": 1,
  "minHostVersion": "0.1",
  "priority": "normal",
  "refreshPolicy": "on-change",
  "permissions": [
    "vibrate",
    "storage"
  ],
  "allowedHosts": [],
  "settings": [
    {
      "key": "shortMs",
      "label": "Short buzz",
      "type": "int",
      "default": 150,
      "min": 20,
      "max": 2000,
      "unit": "ms",
      "help": "Duration of the Short pattern. Applies next time you open it."
    },
    {
      "key": "longMs",
      "label": "Long buzz",
      "type": "int",
      "default": 800,
      "min": 20,
      "max": 2000,
      "unit": "ms",
      "help": "Duration of the Long pattern. Applies next time you open it."
    }
  ]
}
